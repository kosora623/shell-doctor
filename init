#!/usr/bin/env zsh
# =============================================================================
# init — shell-doctor サンプル Zsh 初期化スクリプト
#
# 使い方:
#   1. このファイルを ~/.zshrc にコピーして使う
#   2. shell-doctor でトレース計測する:
#        shell-doctor demo --spawn ~/.zshrc
#   3. ボトルネックを特定して最適化する
# =============================================================================

# ── PATH 設定 ─────────────────────────────────────────────────
export PATH="/usr/local/bin:/usr/bin:/bin:$PATH"

# ── 基本エイリアス ─────────────────────────────────────────────
alias g="git"
alias ll="ls -la"
alias ..="cd .."

# ── Homebrew（重い場合は遅延ロードを検討）──────────────────────
# eval "$(brew shellenv)"

# ── pyenv（起動時間の主要ボトルネックになりやすい）─────────────
# eval "$(pyenv init -)"

# ── nvm（遅延ロードの例）──────────────────────────────────────
# export NVM_DIR="$HOME/.nvm"
# [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # 重い: 遅延ロード推奨

# ── fzf ───────────────────────────────────────────────────────
# [ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

echo "✅ Shell initialized"
